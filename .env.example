# Copia este archivo como .env y llena lo que vayas usando.

# Fase 2 – Veo por API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview   # corre `python -m afiliado listar-modelos` y pon aquí el Lite

# Fase 2 – TikTok for Developers (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost/callback

# Operación
VIDEOS_POR_DIA=4
HORARIOS=12:30,15:30,19:00,21:30
TIPO_CAMBIO=18.5
FONT_PATH=            # vacío = usa Arial Bold de Windows
WHISPER_MODEL=small
# 1 = Veo dice la frase de voz dentro del clip (Flow / API). 0 = tú grabas la voz con el celular.
VOZ_IA=1
